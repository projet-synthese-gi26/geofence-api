# =============================================================
# .env.example -- Variables d'environnement Geofence API
# Copier en .env et remplir les valeurs
# =============================================================

# Base de données (user applicatif DML)
DB_URL=jdbc:postgresql://localhost:5432/geofence_db
DB_USERNAME=geofence_app
DB_PASSWORD=

# Base de données (user Liquibase DDL)
DB_LIQUIBASE_USERNAME=geofence_liquibase
DB_LIQUIBASE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (64 caractères hex obligatoires)
JWT_ENCRYPTION_KEY=

# Application
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
SERVER_PORT=8080

# Bootstrap admin (créé au premier démarrage)
DEFAULT_TENANT_ID=frontend-app
DEFAULT_TENANT_NAME=Frontend Application
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@geofence.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_PHONE=+237600000000
DEFAULT_ADMIN_FIRSTNAME=Admin
DEFAULT_ADMIN_LASTNAME=Geofence
DEFAULT_ADMIN_DOB=1990-01-01
